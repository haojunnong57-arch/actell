        }
      }
    },
    "Save a task draft and open PhoneAgent for confirmation. This does not start the agent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a task draft and open PhoneAgent for confirmation. This does not start the agent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存任务草稿并打开 PhoneAgent 等待确认。不会自动启动 Agent。"
          }
        }
      }
    },
    "Read only a general task state, without task text or results.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read only a general task state, without task text or results."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅查询概括状态，不读取任务文本或结果。"
          }
        }
      }
    },
    "Stop the current run through PhoneAgent. Actions already sent may have happened.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the current run through PhoneAgent. Actions already sent may have happened."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 PhoneAgent 停止当前运行。已发出的动作可能已经执行。"
          }
        }
      }
    },
    "Draft saved. Review it in PhoneAgent and tap Confirm and start. If another task is active, this draft will wait.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft saved. Review it in PhoneAgent and tap Confirm and start. If another task is active, this draft will wait."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已保存。请在 PhoneAgent 核对后点击“确认开始”。如有任务正在运行，草稿会等待。"
          }
        }
      }
    },
    "No task is currently running.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No task is currently running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有正在运行的任务。"
          }
        }
      }
    },
    "A task draft is waiting for your confirmation in PhoneAgent. It has not started.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task draft is waiting for your confirmation in PhoneAgent. It has not started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有任务草稿等待你在 PhoneAgent 中确认，尚未开始。"
          }
        }
      }
    },
    "A task is running in the foreground.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task is running in the foreground."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有任务正在前台运行。"
          }
        }
      }
    },
    "A task is waiting for your approval in PhoneAgent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task is waiting for your approval in PhoneAgent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有任务等待你在 PhoneAgent 中批准动作。"
          }
        }
      }
    },
    "The current task is stopping.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current task is stopping."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前任务正在停止。"
          }
        }
      }
    },
    "Stop requested. Actions already sent may have happened; check your device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop requested. Actions already sent may have happened; check your device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求停止。已发出的动作可能已经执行，请核对设备。"
          }
        }
      }
    },
    "No matching task is currently running.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching task is currently running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有匹配的运行任务。"
          }
        }
      }
    },
    "Enter a task of 1–2,000 characters.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a task of 1–2,000 characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 1 至 2000 字的任务。"
          }
        }
      }
    },
    "The draft could not be saved. Open PhoneAgent and check storage.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft could not be saved. Open PhoneAgent and check storage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿未能保存，请打开 PhoneAgent 检查存储。"
